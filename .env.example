# Google Gemini API Key for dynamic roadmap generation, profiler, and AI tutoring
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# MongoDB Connection String (Optional, fallback in-memory store used if unset)
# Example: mongodb+srv://username:password@cluster.mongodb.net/ai_learning_path?retryWrites=true&w=majority
MONGODB_URI=

# App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
